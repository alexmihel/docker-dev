FROM php:{{PHP_VERSION}}-fpm

ARG INSTALL_GD=false
ARG INSTALL_IMAGICK=false
ARG INSTALL_EXIF=false

RUN apt-get update && apt-get install -y \
    git unzip libpq-dev supervisor mc libzip-dev \
    && docker-php-ext-install \
        pdo \
        pdo_pgsql \
        bcmath \
        zip \
        pcntl \
    && pecl install redis xdebug \
    && docker-php-ext-enable redis xdebug \
    && mkdir -p /var/log/supervisor \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN if [ "$INSTALL_GD" = "true" ]; then \
      apt-get update && apt-get install -y \
        libpng-dev libjpeg-dev libfreetype6-dev \
      && docker-php-ext-configure gd --with-freetype --with-jpeg \
      && docker-php-ext-install gd \
      && apt-get clean && rm -rf /var/lib/apt/lists/*; \
    fi

RUN if [ "$INSTALL_IMAGICK" = "true" ]; then \
      apt-get update && apt-get install -y libmagickwand-dev \
      && pecl install imagick \
      && docker-php-ext-enable imagick \
      && apt-get clean && rm -rf /var/lib/apt/lists/*; \
    fi

RUN if [ "$INSTALL_EXIF" = "true" ]; then \
      docker-php-ext-install exif; \
    fi

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY conf.d/xdebug.ini /usr/local/etc/php/conf.d/99-xdebug.ini
COPY php-fpm.d/zz-env.conf /usr/local/etc/php-fpm.d/zz-env.conf
COPY supervisor/supervisord.conf /etc/supervisor/supervisord.conf
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /var/www/html

ENTRYPOINT ["entrypoint.sh"]
CMD ["supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
