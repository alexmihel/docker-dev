APP={{PROJECT}}_app
DB=db
NODE=node
# Runs as the host user (see docker/entrypoint.sh), so generated files stay editable.
EXEC=docker compose exec -u www-data

# ── Docker ───────────────────────────────────────

up:
	docker compose up -d

down:
	docker compose down

restart:
	docker compose down && docker compose up -d

build:
	docker compose build --no-cache

logs:
	docker compose logs -f

logs-app:
	docker compose logs -f $(APP)

shell:
	$(EXEC) $(APP) bash

shell-root:
	docker compose exec $(APP) bash

# ── PHP / Composer ───────────────────────────────

composer:
	$(EXEC) $(APP) composer $(cmd)

composer-install:
	$(EXEC) $(APP) composer install

artisan:
	$(EXEC) $(APP) php artisan $(cmd)

tinker:
	$(EXEC) $(APP) php artisan tinker

# ── Database ─────────────────────────────────────

migrate:
	$(EXEC) $(APP) php artisan migrate

seed:
	$(EXEC) $(APP) php artisan db:seed

fresh:
	$(EXEC) $(APP) php artisan migrate:fresh --seed

db-dump:
	docker compose exec $(DB) pg_dump -U laravel db_{{PROJECT}} > ./dump_$$(date +%Y%m%d_%H%M%S).sql
	@echo "✅ Dump saved"

db-restore:
	docker compose exec -T $(DB) psql -U laravel db_{{PROJECT}} < $(file)
	@echo "✅ Dump restored"

db-upload:
	scp $(file) $(remote):~/dump.sql
	@echo "✅ Dump uploaded to $(remote)"

# ── Testing ──────────────────────────────────────

test:
	$(EXEC) $(APP) php artisan test

# ── Node / Frontend ──────────────────────────────

npm-install:
	docker compose exec $(NODE) npm install

npm-dev:
	docker compose exec $(NODE) npm run dev

npm-build:
	docker compose exec $(NODE) npm run build

# ── SSH keys (for GitHub / Bitbucket) ────────────

ssh-keygen:
	$(EXEC) $(APP) bash -c "\
		mkdir -p ~/.ssh \
		&& ssh-keygen -t ed25519 -C '{{PROJECT}}@{{DOMAIN}}' -f ~/.ssh/id_ed25519 -N '' \
		&& echo '' \
		&& echo '── Public key (copy and add to GitHub/Bitbucket) ──' \
		&& cat ~/.ssh/id_ed25519.pub"

ssh-show:
	$(EXEC) $(APP) bash -c 'cat ~/.ssh/id_ed25519.pub'

# ── Helpers ──────────────────────────────────────

permissions:
	docker compose exec $(APP) chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

cache-clear:
	$(EXEC) $(APP) php artisan optimize:clear

.PHONY: up down restart build logs logs-app shell shell-root \
        composer composer-install artisan tinker \
        migrate seed fresh db-dump db-restore db-upload \
        test npm-install npm-dev npm-build \
        ssh-keygen ssh-show permissions cache-clear
